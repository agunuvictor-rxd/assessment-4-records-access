# Assessment 4 — Records and Access Slice Environment Configuration

# Server Port (default: 3003)
PORT=3003

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Session Cookie Secret (minimum 32-character random string)
SESSION_SECRET=records-access-session-secret-key-at-least-32!

# SQLite Database Path
DB_PATH=./records.db
